**/*UI5*/TsTests/**/*.js
!**/*UI5*/Tests/JsTests/*.js


**/*UI5.AspNetWeb*/wwwroot/*.js
**/*UI5.Web*/.eslintcache
!**/*UI5.AspNetWeb*/gulpfile.js
**/*UI5*/wwwroot/Modules/**/*.js
**/*UI5*/wwwroot/Views/**/*.js

**/*TypeScriptTest*/Modules/**/*.js
**/*TypeScriptTest*/*.js

